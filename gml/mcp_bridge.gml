/// mcp_bridge.gml - in-game MCP bridge (generated by the gamemaker-mcp server)
/// Exposes a newline-delimited JSON protocol over TCP so AI tooling can
/// inspect and control the running game.
///
/// Protocol: one JSON object per line, both directions.
/// Request:  { "id": "1", "cmd": "instances.list", "args": { ... } }
/// Response: { "id": "1", "ok": true, ... }  |  { "id": "1", "ok": false, "error": "..." }

function mcp_bridge_config() {
    return {
        port: __MCP_PORT__,
        logLimit: 300,
        maxLineBytes: 1048576,
        maxClients: 4,
        verbose: true,
    };
}

function mcp_bridge_log(_msg) {
    if (!variable_global_exists("mcp_bridge")) return;
    var _s = global.mcp_bridge;
    array_push(_s.logLines, string(_msg));
    if (array_length(_s.logLines) > _s.cfg.logLimit) {
        array_delete(_s.logLines, 0, array_length(_s.logLines) - _s.cfg.logLimit);
    }
    if (_s.cfg.verbose) show_debug_message("[mcp_bridge] " + string(_msg));
}

function mcp_bridge_init(_cfg) {
    if (!variable_global_exists("mcp_bridge")) {
        global.mcp_bridge = {
            cfg: _cfg,
            server: -1,
            port: _cfg.port,
            clients: {},
            logLines: [],
            lastTry: 0,
            started: current_time,
            errorFile: working_directory + "mcp_bridge_error.txt",
            owner: id,
            handled: 0,
        };
    }
    var _s = global.mcp_bridge;
    if (_s.server >= 0) return; // already serving

    var _srv = -1;
    var _port = _cfg.port;
    while (_srv < 0 && _port < _cfg.port + 32) {
        // raw server: no GameMaker packet headers / login handshake - plain TCP
        _srv = network_create_server_raw(network_socket_tcp, _port, _cfg.maxClients);
        if (_srv < 0) _port++;
    }
    if (_srv < 0) {
        _s.lastTry = current_time;
        mcp_bridge_log("ERROR: failed to bind a port in " + string(_cfg.port) + ".." + string(_cfg.port + 31));
    } else {
        _s.server = _srv;
        _s.port = _port;
        mcp_bridge_log("MCP bridge listening on port " + string(_port));
    }
    exception_unhandled_handler(mcp_bridge_on_exception);
}

function mcp_bridge_cleanup() {
    if (!variable_global_exists("mcp_bridge")) return;
    var _s = global.mcp_bridge;
    var _keys = variable_struct_get_names(_s.clients);
    for (var i = 0; i < array_length(_keys); i++) {
        var _c = variable_struct_get(_s.clients, _keys[i]);
        if (_c.sock >= 0) network_destroy(_c.sock);
    }
    if (_s.server >= 0) network_destroy(_s.server);
    _s.server = -1;
    mcp_bridge_log("bridge closed");
}

/// Convert any GML value into JSON-safe data.
function mcp_bridge_to_json(_v) {
    if (_v == undefined) return { __undefined: true };
    var _t = typeof(_v);
    if (_t == "number" || _t == "ref") return mcp_bridge_ref_to_number(_v);
    if (_t == "string" || _t == "bool") return _v;
    try {
        return json_parse(json_stringify(_v));
    } catch (e) {
        return { __type: _t, text: string(_v) };
    }
}

/// True if the string is a plain numeric literal (so real() is safe).
function mcp_bridge_string_is_number(_st) {
    if (string_length(_st) == 0) return false;
    for (var i = 1; i <= string_length(_st); i++) {
        var _ch = string_char_at(_st, i);
        if (!((_ch >= "0" && _ch <= "9") || _ch == "-" || _ch == "+" || _ch == "." || _ch == "e")) {
            return false;
        }
    }
    return true;
}

/// Modern GML renders references as "ref instance 100003" (string()) or
/// "@ref instance(100003)" (json_stringify) - turn those back into the
/// numeric id. Plain numbers (including negatives) pass through untouched.
function mcp_bridge_ref_to_number(_v) {
    var _st = string(_v);
    if (mcp_bridge_string_is_number(_st)) return real(_st);
    if (string_pos("ref ", _st) == 1 || string_pos("@ref ", _st) == 1) {
        var _digits = "";
        for (var i = string_length(_st); i >= 1; i--) {
            var _ch = string_char_at(_st, i);
            if (_ch == ")" || _ch == "(") continue;
            if (_ch >= "0" && _ch <= "9") {
                _digits = _ch + _digits;
                continue;
            }
            break;
        }
        if (string_length(_digits) > 0) return real(_digits);
    }
    return _v;
}

/// Send one JSON response object (newline terminated raw TCP) to a client.
function mcp_bridge_send(_key, _res) {
    var _s = global.mcp_bridge;
    if (!variable_struct_exists(_s.clients, _key)) return;
    var _c = variable_struct_get(_s.clients, _key);
    var _json = json_stringify(_res);
    if (_json == undefined) {
        _json = json_stringify({ id: _res.id, ok: false, error: "unserialisable response" });
    }
    var _buf = buffer_create(string_byte_length(_json) + 8, buffer_fixed, 1);
    buffer_write(_buf, buffer_string, _json);
    var _end = buffer_tell(_buf);
    buffer_seek(_buf, buffer_seek_start, _end - 1); // replace null terminator with newline
    buffer_write(_buf, buffer_u8, 10);
    network_send_raw(_c.sock, _buf, _end);
    buffer_delete(_buf);
}

/// Handle one complete request line and send the response.
function mcp_bridge_handle(_key, _line) {
    var _s = global.mcp_bridge;
    _s.handled++;
    var _req = undefined;
    try {
        _req = json_parse(_line);
    } catch (e) {
        _req = undefined;
    }
    if (!is_struct(_req)) {
        mcp_bridge_send(_key, { id: "?", ok: false, error: "invalid JSON request" });
        return;
    }
    var _id = variable_struct_exists(_req, "id") ? string(_req.id) : "?";
    var _cmd = variable_struct_exists(_req, "cmd") ? string(_req.cmd) : "?";
    var _args = variable_struct_exists(_req, "args") && is_struct(_req.args) ? _req.args : {};
    var _res = undefined;
    try {
        _res = mcp_bridge_dispatch(_id, _cmd, _args);
    } catch (e) {
        _res = { id: _id, ok: false, error: "dispatch error: " + string(e.message) };
    }
    mcp_bridge_send(_key, _res);
}

function mcp_bridge_resolve_object(_ref) {
    if (is_real(_ref)) return _ref;
    return asset_get_index(string(_ref));
}

function mcp_bridge_resolve_instance(_ref) {
    if (is_real(_ref)) return _ref;
    return mcp_bridge_ref_to_number(string(_ref));
}

function mcp_bridge_instance_object(_inst) {
    var _oi = -1;
    with (_inst) {
        _oi = object_index;
    }
    return _oi;
}

function mcp_bridge_keycode(_k) {
    if (is_real(_k)) return _k;
    var _name = string_lower(string(_k));
    var _map = {
        "space": 32, "enter": 13, "return": 13, "escape": 27, "esc": 27, "tab": 9,
        "left": 37, "up": 38, "right": 39, "down": 40,
        "shift": 16, "control": 17, "ctrl": 17, "alt": 18,
        "backspace": 8, "delete": 46, "home": 36, "end": 35,
    };
    if (variable_struct_exists(_map, _name)) return variable_struct_get(_map, _name);
    if (string_length(_name) == 1) {
        var _c = ord(string_upper(_name));
        if ((_c >= 48 && _c <= 57) || (_c >= 65 && _c <= 90)) return _c;
    }
    if (string_length(_name) >= 2 && string_length(_name) <= 3 && string_char_at(_name, 1) == "f") {
        var _numst = string_delete(_name, 1, 1);
        if (mcp_bridge_string_is_number(_numst)) {
            var _n = real(_numst);
            if (_n >= 1 && _n <= 12) return 111 + _n;
        }
    }
    return -1;
}

function mcp_bridge_dispatch(_id, _cmd, _args) {
    var _s = global.mcp_bridge;
    var _res = { id: _id, ok: true };

    switch (_cmd) {
        case "ping":
            _res.pong = true;
            _res.port = _s.port;
            _res.handled = _s.handled;
            break;

        case "info":
            _res.version = GM_version;
            _res.room = room_get_name(room);
            _res.roomWidth = room_width;
            _res.roomHeight = room_height;
            _res.instances = instance_count;
            _res.fps = fps;
            _res.fpsReal = fps_real;
            _res.windowWidth = window_get_width();
            _res.windowHeight = window_get_height();
            _res.wd = working_directory;
            _res.saveArea = game_save_id;
            _res.os = os_type;
            _res.uptimeMs = current_time - _s.started;
            _res.logCount = array_length(_s.logLines);
            break;

        case "globals.get":
            var _names = variable_struct_exists(_args, "names") ? _args.names : [];
            var _vals = {};
            for (var i = 0; i < array_length(_names); i++) {
                var _n = string(_names[i]);
                if (variable_global_exists(_n)) {
                    variable_struct_set(_vals, _n, mcp_bridge_to_json(variable_global_get(_n)));
                } else {
                    variable_struct_set(_vals, _n, { "__missing": true });
                }
            }
            _res.values = _vals;
            break;

        case "globals.set":
            var _set = variable_struct_exists(_args, "values") ? _args.values : {};
            var _keys = variable_struct_get_names(_set);
            var _done = [];
            for (var i = 0; i < array_length(_keys); i++) {
                variable_global_set(_keys[i], variable_struct_get(_set, _keys[i]));
                array_push(_done, _keys[i]);
            }
            _res.set = _done;
            break;

        case "instances.list":
            var _filter = variable_struct_exists(_args, "object") ? mcp_bridge_resolve_object(_args.object) : -1;
            var _fields = variable_struct_exists(_args, "fields") ? _args.fields : [];
            if (array_length(_fields) == 0) _fields = ["x", "y"];
            var _limit = variable_struct_exists(_args, "limit") ? _args.limit : 200;
            var _list = [];
            var _n = instance_count;
            for (var i = 0; i < _n; i++) {
                var _inst = instance_find(all, i);
                var _oid = mcp_bridge_instance_object(_inst);
                if (_filter >= 0 && _oid != _filter) continue;
                if (array_length(_list) >= _limit) break;
                var _e = { id: mcp_bridge_ref_to_number(_inst), object: object_get_name(_oid) };
                for (var j = 0; j < array_length(_fields); j++) {
                    var _v = undefined;
                    try {
                        _v = variable_instance_get(_inst, string(_fields[j]));
                    } catch (fe) {
                        _v = undefined;
                    }
                    variable_struct_set(_e, string(_fields[j]), mcp_bridge_to_json(_v));
                }
                array_push(_list, _e);
            }
            _res.instances = _list;
            _res.total = _n;
            break;

        case "instances.get":
            var _inst = mcp_bridge_resolve_instance(_args.id);
            if (!instance_exists(_inst)) {
                _res.ok = false;
                _res.error = "instance not found: " + string(_args.id);
                break;
            }
            var _e = { id: mcp_bridge_ref_to_number(_inst), object: object_get_name(mcp_bridge_instance_object(_inst)) };
            var _names = variable_instance_get_names(_inst);
            var _vars = {};
            for (var i = 0; i < array_length(_names); i++) {
                var _v = undefined;
                try {
                    _v = variable_instance_get(_inst, _names[i]);
                } catch (fe) {
                    continue;
                }
                if (is_method(_v)) continue;
                variable_struct_set(_vars, _names[i], mcp_bridge_to_json(_v));
            }
            _e.vars = _vars;
            _res.instance = _e;
            break;

        case "instances.set":
            var _inst = mcp_bridge_resolve_instance(_args.id);
            if (!instance_exists(_inst)) {
                _res.ok = false;
                _res.error = "instance not found: " + string(_args.id);
                break;
            }
            var _vals = variable_struct_exists(_args, "values") ? _args.values : {};
            var _vkeys = variable_struct_get_names(_vals);
            for (var i = 0; i < array_length(_vkeys); i++) {
                variable_instance_set(_inst, _vkeys[i], variable_struct_get(_vals, _vkeys[i]));
            }
            _res.set = _vkeys;
            break;

        case "instances.create":
            var _oid = mcp_bridge_resolve_object(_args.object);
            if (_oid < 0 || !object_exists(_oid)) {
                _res.ok = false;
                _res.error = "object not found: " + string(_args.object);
                break;
            }
            var _x = variable_struct_exists(_args, "x") ? _args.x : 0;
            var _y = variable_struct_exists(_args, "y") ? _args.y : 0;
            var _layerName = variable_struct_exists(_args, "layer") ? string(_args.layer) : "Instances";
            var _new = noone;
            if (layer_get_id(_layerName) != -1) {
                _new = instance_create_layer(_x, _y, _layerName, _oid);
            } else {
                var _depth = variable_struct_exists(_args, "depth") ? _args.depth : 0;
                _new = instance_create_depth(_x, _y, _depth, _oid);
            }
            _res.instance = mcp_bridge_ref_to_number(_new);
            _res.object = object_get_name(_oid);
            break;

        case "instances.destroy":
            var _inst = mcp_bridge_resolve_instance(_args.id);
            if (!instance_exists(_inst)) {
                _res.ok = false;
                _res.error = "instance not found: " + string(_args.id);
                break;
            }
            instance_destroy(_inst);
            _res.destroyed = true;
            break;

        case "rooms.change":
            var _room = is_real(_args.room) ? _args.room : asset_get_index(string(_args.room));
            if (_room < 0 || !room_exists(_room)) {
                _res.ok = false;
                _res.error = "room not found: " + string(_args.room);
                break;
            }
            _res.room = room_get_name(_room);
            room_goto(_room);
            break;

        case "functions.call":
            var _fname = string(variable_struct_get(_args, "function"));
            var _fn = variable_global_get(_fname);
            if (!is_callable(_fn)) {
                var _ai = asset_get_index(_fname);
                if (_ai >= 0 && script_exists(_ai)) _fn = _ai;
            }
            if (!is_callable(_fn)) {
                _res.ok = false;
                _res.error = "function not found: " + _fname;
                break;
            }
            var _params = variable_struct_exists(_args, "args") ? _args.args : [];
            var _result = method_call(_fn, _params);
            _res.result = mcp_bridge_to_json(_result);
            break;

        case "eval":
            if (variable_global_exists("__mcp_eval") || variable_global_exists("execute_string")) {
                var _en = variable_global_exists("__mcp_eval") ? "__mcp_eval" : "execute_string";
                var _efn = variable_global_get(_en);
                var _erv = method_call(_efn, [string(_args.code)]);
                _res.result = mcp_bridge_to_json(_erv);
            } else {
                _res.ok = false;
                _res.error = "eval is not available: define a global function __mcp_eval(code) in the game (e.g. via the community execute_string library) to enable it";
            }
            break;

        case "screenshot":
            var _spath = variable_struct_exists(_args, "path") ? string(_args.path) : "mcp_screenshot.png";
            screen_save(_spath);
            _res.path = _spath;
            _res.saveArea = game_save_id;
            break;

        case "keys":
            var _code = mcp_bridge_keycode(_args.key);
            if (_code < 0) {
                _res.ok = false;
                _res.error = "unknown key: " + string(_args.key);
                break;
            }
            var _action = variable_struct_exists(_args, "action") ? string(_args.action) : "press";
            if (_action == "press") keyboard_key_press(_code);
            else if (_action == "release") keyboard_key_release(_code);
            else if (_action == "clear") keyboard_clear(_code);
            else {
                _res.ok = false;
                _res.error = "unknown action (press|release|clear): " + _action;
                break;
            }
            _res.key = _code;
            _res.action = _action;
            break;

        case "logs.get":
            var _since = variable_struct_exists(_args, "since") ? _args.since : 0;
            var _out = [];
            for (var i = max(0, _since); i < array_length(_s.logLines); i++) {
                array_push(_out, _s.logLines[i]);
            }
            _res.logs = _out;
            _res.total = array_length(_s.logLines);
            break;

        case "game.speed":
            if (variable_struct_exists(_args, "fps")) game_set_speed(_args.fps, gamespeed_fps);
            _res.fps = game_get_speed(gamespeed_fps);
            break;

        default:
            _res.ok = false;
            _res.error = "unknown command: " + _cmd;
            break;
    }
    return _res;
}

/// Unhandled exception handler: report to the bridge log, write the save-area
/// error file (read by the MCP server) and end the game instead of showing a
/// blocking error dialog.
function mcp_bridge_on_exception(_e) {
    var _msg = "UNHANDLED EXCEPTION: " + string(_e.message) + "\n" + string(_e.longMessage);
    mcp_bridge_log(_msg);
    try {
        var _b = buffer_create(65536, buffer_grow, 1);
        buffer_write(_b, buffer_string, _msg);
        buffer_save(_b, "mcp_bridge_error.txt");
        buffer_delete(_b);
    } catch (we) {
        /* best effort */
    }
    game_end();
}

